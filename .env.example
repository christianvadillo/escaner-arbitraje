# Copia este archivo a .env y ajusta lo que aplique. Prefijo ESCANER_ para todo.
# Ver src/escaner/config.py (Settings.from_env) para el mapeo exacto de nombre -> variable.

# ── Mercado Libre (OAuth) ───────────────────────────────────────────────────────────────
# App propia creada en https://developers.mercadolibre.com.mx/ . Sin esto, `escaner scan`
# y `escaner paper mark` no pueden hacer nada: casi todos los endpoints que importan (search,
# products/search, listing_prices, ...) devuelven 403 sin OAuth de usuario (ver
# docs/ESPECIFICACION.md §2 -- verificado en vivo).
ESCANER_ML_APP_ID=
ESCANER_ML_CLIENT_SECRET=
ESCANER_ML_REDIRECT_URI=https://localhost/callback
# Opcional: si se deja vacío, se resuelve solo con GET /users/me usando el access_token.
ESCANER_ML_USER_ID=

# ── Rutas ────────────────────────────────────────────────────────────────────────────────
ESCANER_TOKEN_PATH=data/ml_token.json
ESCANER_DB_PATH=data/escaner.db

# ── Identificación honesta ante los sitios que se scrapean ────────────────────────────────
ESCANER_CONTACT=contacto@ejemplo.com
# Si se deja vacío, se deriva como "escaner-arbitraje/0.1 (+uso personal; contacto: <CONTACT>)".
ESCANER_USER_AGENT=
# Segundos mínimos entre peticiones al MISMO host (PoliteClient usa max(esto, Crawl-delay)).
ESCANER_MIN_HOST_INTERVAL_S=10

# ── Umbrales de decisión (ESPECIFICACION §1 y §5) ──────────────────────────────────────────
ESCANER_MIN_ROI=0.15
ESCANER_MIN_PROFIT=150
ESCANER_MATCH_THRESHOLD=0.90
ESCANER_REVIEW_THRESHOLD=0.60
ESCANER_UNDERCUT=0.02
ESCANER_MIN_COMPARABLES=3

# ── Supuestos de costeo (economics/profit.py::CostAssumptions) ────────────────────────────
# Perfiles válidos: sin_rfc | plataformas | resico | empresarial (economics/taxes.py)
ESCANER_TAX_PROFILE=plataformas
# Reputación del vendedor (afecta el descuento en envío): lider|green|light_green|yellow|none|orange|red
ESCANER_REPUTATION=green
# Tipo de publicación: gold_special (Clásica) | gold_pro (Premium)
ESCANER_LISTING_TYPE=gold_special
# Peso de respaldo (gramos) cuando ni JSON-LD ni los atributos de ML lo traen.
ESCANER_DEFAULT_WEIGHT_G=1000

# ── Keepa (Amazon MX) ───────────────────────────────────────────────────────────────────
# https://keepa.com/#!api -- de pago, ~5 tokens por consulta de /deal.
ESCANER_KEEPA_KEY=

# ── Juez LLM opcional para la banda "revisar" (0.60-0.90) ─────────────────────────────────
# Requiere el extra `llm`: pip install -e .[llm]  (o [dev], que ya lo incluye).
# Usa la variable de entorno estándar ANTHROPIC_API_KEY del SDK -- no hay ESCANER_ para la key.
ESCANER_LLM_ENABLED=false
ESCANER_LLM_MODEL=claude-opus-5
ESCANER_LLM_EFFORT=low

# ── Hosts donde SÍ se permite enriquecer una oferta leyendo su página (JSON-LD) ────────────
# Lista separada por comas. Ver ESPECIFICACION.md §3 -- Walmart MX/Liverpool/Coppel NUNCA van
# aquí: están en una lista negra dura dentro de http.py, no en configuración.
ESCANER_ALLOWED_PRODUCT_HOSTS=bodegaaurrera.com.mx,homedepot.com.mx,costco.com.mx
